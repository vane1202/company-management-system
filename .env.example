# 复制为 .env 后填写本地或服务器上的值。不要把填好的 .env 提交到仓库。
# 以下均为占位符，不是可用的生产密钥。

# 应用
NODE_ENV=development
HOST=127.0.0.1
PORT=13080
APP_ORIGIN=http://127.0.0.1:15173,http://127.0.0.1:13080
BUSINESS_TIMEZONE=Asia/Shanghai
FAN_REPORT_BACKFILL_DAYS=3
SERVE_STATIC=false
TRUST_PROXY=0
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# 必填：会话签名。请换成足够长的随机串（例如 openssl rand -hex 32）
SESSION_SECRET=replace-with-long-random-string

# 数据库（Docker Compose 默认把宿主机端口映射到 127.0.0.1:15432）
DATABASE_URL=postgres://cms:replace-with-strong-local-password@127.0.0.1:15432/cms

# 仅 Docker Compose 使用
POSTGRES_USER=cms
POSTGRES_PASSWORD=replace-with-strong-local-password
POSTGRES_DB=cms
POSTGRES_PORT=15432

# 登录限速
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=8

# 可选：非交互初始化管理员（不要写入仓库，不要用于生产默认密码）
# INIT_ADMIN_USERNAME=
# INIT_ADMIN_PASSWORD=
# INIT_ADMIN_NAME=

# 可选演示数据：必须显式 SEED_DEMO=1 才会写入虚构账号
# SEED_DEMO=0
# SEED_DEMO_CREDENTIALS_FILE=data/demo-credentials.txt
