# Windows 内测占位模板。请使用 scripts\New-CmsEnv.ps1 生成真正的 .env，不要手工把真实口令提交或发到聊天。
# 以下端口是建议值：应用 13082，数据库 15434。以本机实际 PostgreSQL 端口为准。

NODE_ENV=production
HOST=127.0.0.1
PORT=13082
APP_ORIGIN=http://127.0.0.1:13082
BUSINESS_TIMEZONE=Asia/Shanghai
FAN_REPORT_BACKFILL_DAYS=3
SERVE_STATIC=true
TRUST_PROXY=0
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_SECRET=replace-with-long-random-string
DATABASE_URL=postgres://cms:replace-with-strong-local-password@127.0.0.1:15434/cms
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=8
